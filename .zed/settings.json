// Zed project settings. clangd finds the compile DB via the root `.clangd`
// file (build/compile_commands.json) — run `just configure` once first.
{
  "languages": {
    "C++": {
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=iwyu"
        ]
      }
    }
  }
}
